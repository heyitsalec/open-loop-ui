{
  "name": "@alecbot/open-loop-ui",
  "version": "0.1.0",
  "description": "A drop-in floating design feedback loop for React apps.",
  "author": "Alec Bot <hey@heyitsalec.com>",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "sideEffects": [
    "src/styles.css",
    "dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./adapters/cli": {
      "types": "./dist/adapters/cli.d.ts",
      "import": "./dist/adapters/cli.js"
    },
    "./adapters/mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/**/*.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyitsalec/open-loop-ui.git"
  },
  "bugs": {
    "url": "https://github.com/heyitsalec/open-loop-ui/issues"
  },
  "homepage": "https://heyitsalec.github.io/open-loop-ui/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-dist.mjs && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/copy-styles.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "npm run build && node tests/consumer/verify-packed-package.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/demo.spec.ts",
    "capture": "node scripts/capture-assets.mjs",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:demo && npm run test:e2e:smoke && npm run test:consumer && npm pack --dry-run",
    "prepack": "npm run build",
    "stories": "ladle serve",
    "build:stories": "ladle build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.554.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jiti": "^2.6.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  },
  "keywords": [
    "react",
    "feedback",
    "design-review",
    "ui",
    "agent",
    "cli"
  ],
  "license": "MIT"
}
